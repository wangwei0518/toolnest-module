{
  "platform": "toolnest-react-backend",
  "manifest_version": 1,
  "id": "temporary-transfer",
  "name": "文件邮局",
  "version": "0.1.24",
  "description": "跨设备临时文件与文字投递",
  "author": "ToolNest",
  "icon": "box",
  "minimum_core_version": ">=0.1.0",
  "runtime": {
    "kind": "native",
    "executables": {
      "linux/amd64": "backend/bin/file-post-linux-amd64",
      "linux/arm64": "backend/bin/file-post-linux-arm64",
      "windows/amd64": "backend/bin/file-post-windows-amd64.exe"
    },
    "http_shutdown": true,
    "transport": "http",
    "startup": "eager",
    "startup_timeout_ms": 15000,
    "shutdown_timeout_ms": 20000,
    "request_timeout_ms": 180000,
    "restart_policy": "on-failure",
    "max_restart_count": 3,
    "public_paths": ["/public"]
  },
  "api": {
    "base_path": "/api/v1/modules/temporary-transfer"
  },
  "frontend": {
    "framework": "react",
    "entry": "frontend/dist/index.js",
    "style": "frontend/dist/style.css",
    "shared_dependencies": [
      "react",
      "react-dom",
      "react/jsx-runtime",
      "@toolnest/react-module-sdk"
    ]
  },
  "permissions": [
    "temporary.transfer.read",
    "temporary.transfer.create",
    "temporary.transfer.update",
    "temporary.transfer.delete"
  ],
  "capabilities": [
    "temporary.transfer.basic"
  ],
  "menus": [
    {
      "key": "temporary-transfer",
      "label": "文件邮局",
      "path": "",
      "icon": "box",
      "order": 100
    }
  ],
  "settings": []
}
