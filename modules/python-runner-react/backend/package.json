    "js-yaml": "^4.1.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
